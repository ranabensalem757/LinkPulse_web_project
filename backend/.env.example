# Copiez ce fichier en `.env` puis adaptez les valeurs. Ne commitez JAMAIS `.env`.

# Port de l'API (le proxy Angular vise 3000 par défaut)
PORT=3000

# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Dossier des fichiers de données (clients.json, donnees.json, sessions.json). Défaut : dossier backend/
# DATA_DIR=./data

# DÉVELOPPEMENT UNIQUEMENT : autorise la surveillance de localhost / réseau privé.
# Laissez à false en production (protection anti-SSRF).
ALLOW_PRIVATE_TARGETS=false

# Derrière un reverse proxy (nginx, Render…) : nombre de proxys de confiance
# TRUST_PROXY=1

# E-mails de réinitialisation. Sans SMTP, un compte de test Ethereal est utilisé.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
